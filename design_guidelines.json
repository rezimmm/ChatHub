{
  "identity": {
    "name": "E1",
    "role": "Creative Designer",
    "principles": [
      "Fusion over Imitation",
      "Emotion First",
      "Content is King",
      "Zoom In",
      "Negative Space",
      "Contrast"
    ],
    "anti_patterns": [
      "Purple/Teal for CTA (unless specific brand)",
      "Inter everywhere (Headings must be distinct)",
      "Center-Everything Disease",
      "Gradient Overload"
    ]
  },
  "project_context": {
    "app_type": "SaaS Chat & Collaboration Platform",
    "target_audience": "Professional teams, enterprises, tech companies",
    "emotional_tone": "Focused, Efficient, Connected, Modern",
    "visual_style": "Soft Utility / High-Performance Dark Mode"
  },
  "typography": {
    "fonts": {
      "headings": {
        "family": "Manrope, sans-serif",
        "weights": ["600", "700", "800"],
        "usage": "All headers (h1-h6), modal titles, section labels"
      },
      "body": {
        "family": "Inter, sans-serif",
        "weights": ["400", "500"],
        "usage": "Message text, inputs, sidebar items, general UI"
      },
      "code": {
        "family": "JetBrains Mono, monospace",
        "weights": ["400"],
        "usage": "Code snippets, technical data, IDs"
      }
    },
    "rules": [
      "Headings > 32px must use tracking-tight",
      "Overlines/Labels must be Uppercase + tracking-widest + text-xs",
      "Line height: leading-none for headers, leading-relaxed for message body"
    ]
  },
  "colors": {
    "theme_strategy": "Dual Theme (Light/Dark Toggle)",
    "palette": {
      "primary": {
        "name": "Electric Violet",
        "hex": "#7c3aed",
        "tailwind": "violet-600",
        "usage": "Primary buttons, active states, key accents"
      },
      "secondary": {
        "name": "Vibrant Teal",
        "hex": "#0d9488",
        "tailwind": "teal-600",
        "usage": "Success states, online indicators, secondary accents"
      },
      "light_mode": {
        "background": "#ffffff",
        "surface": "#f8fafc",
        "surface_highlight": "#f1f5f9",
        "text_primary": "#0f172a",
        "text_secondary": "#64748b",
        "border": "#e2e8f0"
      },
      "dark_mode": {
        "background": "#0f172a",
        "surface": "#1e293b",
        "surface_highlight": "#334155",
        "text_primary": "#f8fafc",
        "text_secondary": "#94a3b8",
        "border": "#1e293b"
      }
    },
    "gradients": {
      "forbidden": ["Full screen gradients", "Dark gradients"],
      "allowed": ["Subtle mesh gradients for empty states or login backgrounds"]
    }
  },
  "layout": {
    "grid_system": "High Density Grid (Mode B)",
    "spacing": {
      "base": "Comfortable Density",
      "chat_message": "py-1 px-4 hover:bg-accent/50",
      "sidebar_item": "py-1.5 px-2",
      "container_padding": "p-4 md:p-6"
    },
    "structure": {
      "sidebar_width": "w-[280px] or w-[320px]",
      "thread_sidebar_width": "w-[350px]",
      "chat_area": "flex-1 flex flex-col"
    },
    "z_index": {
      "modal": 50,
      "popover": 40,
      "header": 30,
      "sidebar": 20
    }
  },
  "components": {
    "buttons": {
      "style": "Pill-shaped or slightly rounded (rounded-md)",
      "interaction": "transform active:scale-95 transition-all duration-200",
      "shadow": "shadow-sm hover:shadow-md"
    },
    "inputs": {
      "style": "Flat, border-b-2 or subtle ring. No default browser styles.",
      "focus": "ring-2 ring-primary/20 border-primary"
    },
    "cards": {
      "style": "Flat, border border-border, bg-card",
      "hover": "hover:border-primary/50 transition-colors"
    },
    "chat_bubbles": {
      "style": "Cardless for main chat. Hover reveals actions.",
      "user_message": "bg-primary/10 text-primary-foreground (optional, or just text)",
      "system_message": "text-muted-foreground text-sm italic"
    },
    "modals": {
      "style": "Backdrop blur-sm, centered, rounded-xl, border border-border shadow-2xl"
    }
  },
